<Window x:Class="AnnotationsExtractor.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplashWindow"
        Width="520"
        Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border
        CornerRadius="18"
        BorderThickness="1"
        >
        <Border.Background>
            <ImageBrush ImageSource="/Resources/Images/AppLogo.png"/>
        </Border.Background>


        <Border.Effect>
            <DropShadowEffect
                BlurRadius="30"
                ShadowDepth="4"
                Opacity="0.25" />
        </Border.Effect>

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Contenido principal -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">

                <TextBlock
                    Text="Extractor de Anotaciones"
                    FontSize="28"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" Background="White" />
                <TextBlock
                    Text="Genera hojas de cálculo con los informes de Appoderado"
                    FontSize="14"
                    Foreground="#FF7F2020"
                    Background="#FFFFDC7C" />

            </StackPanel>

            <!-- Estado -->
            <Border
                Background="#FF131313"
                Padding="3,3" Margin="136,19,136,-34" Grid.Row="2"
                CornerRadius="12"
                >
                <TextBlock
                    x:Name="StatusTextBlock"
                    Grid.Row="1"
                    Text="Iniciando aplicación..."
                    FontSize="12"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0" />
            </Border>
            <!-- Progreso -->
            <ProgressBar
                Grid.Row="2"
                Height="4"
                IsIndeterminate="True"
                BorderThickness="0" />

        </Grid>

    </Border>

</Window>