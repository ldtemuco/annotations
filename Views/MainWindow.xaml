<Window x:Class="AnnotationsExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Height="720"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <StackPanel Orientation="Horizontal">

                <Button x:Name="OpenReportButton"
                Width="180"
                Height="36"
                                    
                Click="OpenReportButton_Click"/>

                <Button x:Name="BatchProcessButton"
                Width="180"
                Height="36"
                Margin="10,0,0,0"              
                Click="BatchProcessButton_Click"/>

                <Button x:Name="ExportExcelButton"
                Width="180"
                Height="36"
                Margin="10,0,0,0"
                
                IsEnabled="False"
                Click="ExportExcelButton_Click"/>

            </StackPanel>

            <CheckBox x:Name="ShowOutputCheckBox"
              Margin="0,10,0,0"
           
              IsChecked="False"
              Checked="ShowOutputCheckBox_Changed"
              Unchecked="ShowOutputCheckBox_Changed"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0">

            <TextBlock Text="Lectura del informe"
                       FontWeight="SemiBold"/>

            <ProgressBar x:Name="ReadProgressBar"
                         Height="18"
                         Margin="0,5,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="ReadStatusTextBlock"
                       Margin="0,4,0,0"
                       Text="Esperando informe..."
                       Foreground="DimGray"/>

            <TextBlock Margin="0,15,0,0"
                       Text="Conversión a Excel"
                       FontWeight="SemiBold"/>

            <ProgressBar x:Name="ExportProgressBar"
                         Height="18"
                         Margin="0,5,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="ExportStatusTextBlock"
                       Margin="0,4,0,0"
                       Text="Sin exportar."
                       Foreground="DimGray"/>

        </StackPanel>

        <TextBox x:Name="OutputTextBox"
                 Grid.Row="2"
                 Margin="0,18,0,0"
                 Padding="10"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

    </Grid>

</Window>